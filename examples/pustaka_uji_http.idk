# pustaka/uji_http.idk - menguji aplikasi web.idk tanpa membuka port.
# Klien memanggil app.tangani() langsung di proses yang sama.

impor web
impor uji_http
dari uji_http impor GalatUjiHttp
impor "pustaka/json.idk"

variabel app = web.Aplikasi()

app.rute("GET", "/halo/:nama", fungsi(req) {
    kembalikan web.json(200, json_teks({"pesan": "halo " + req["params"]["nama"]}))
})

app.rute("POST", "/gema", fungsi(req) {
    kembalikan web.json(201, json_teks({"json": req["json"], "form": req["form"],
                                        "byte": panjang_byte(req["badan"])}))
})

app.rute("POST", "/masuk", fungsi(req) {
    jika req["form"]["sandi"] != "rahasia" {
        kembalikan web.teks(401, "sandi salah")
    }
    kembalikan web.set_kuki(web.teks(200, "selamat datang"), "sesi", "abc123",
                            {"httponly": benar})
})

app.rute("GET", "/profil", fungsi(req) {
    variabel kuki = web.baca_kuki(req)
    jika tidak "sesi" dalam kuki {
        kembalikan web.teks(401, "belum masuk")
    }
    kembalikan web.json(200, json_teks({"sesi": kuki["sesi"]}))
})

app.rute("POST", "/keluar", fungsi(req) {
    kembalikan web.set_kuki(web.teks(200, "sampai jumpa"), "sesi", "", {"max-age": 0})
})

variabel k = uji_http.klien(app)

# Status, header, JSON.
variabel r = k.ambil("/halo/budi")
cetak(r)
r.pastikan_status(200).pastikan_kepala("Content-Type", "application/json")
r.pastikan_json({"pesan": "halo budi"})
cetak("json:", r.json())

# json= dan form=; Content-Length dihitung dalam byte (é = 2 byte).
r = k.kirim("/gema", json = {"nama": "Andé", "nilai": [1, 2]})
r.pastikan_status(201).pastikan_json_berisi({"byte": 30})
cetak("gema json:", r.json()["json"])
r = k.kirim("/gema", form = {"nama": "Andi Putra", "kota": "a&b=c%"})
cetak("gema form:", r.json()["form"])

# Toples kuki: Set-Cookie disimpan dan dikirim balik otomatis.
k.ambil("/profil").pastikan_status(401)
k.kirim("/masuk", form = {"sandi": "salah"}).pastikan_status(401).pastikan_badan_berisi("salah")
r = k.kirim("/masuk", form = {"sandi": "rahasia"})
r.pastikan_status(200).pastikan_kuki("sesi", "abc123")
cetak("kuki klien:", k.kuki)
k.ambil("/profil").pastikan_status(200).pastikan_json({"sesi": "abc123"})
k.kirim("/keluar").pastikan_status(200)
cetak("kuki setelah keluar:", k.kuki)
k.ambil("/profil").pastikan_status(401)

# Rute tidak ada, JSON rusak (ditolak web.idk dengan 400).
k.ambil("/tidak-ada").pastikan_status(404)
k.kirim("/gema", badan = "{rusak", kepala = {"Content-Type": "application/json"}).pastikan_status(400)

# Asersi yang gagal menaikkan GalatUjiHttp dengan ringkasan respons.
coba {
    k.ambil("/halo/siti").pastikan_status(201)
} kecuali GalatUjiHttp sebagai e {
    cetak("gagal:", e.pesan)
}
coba {
    k.ambil("/halo/siti").pastikan_json_berisi({"pesan": "halo budi"})
} kecuali GalatPenegasan sebagai e {
    cetak("gagal:", e.pesan)
}

# permintaan_mentah(): teks request untuk app.tangani() langsung.
variabel mentah = uji_http.permintaan_mentah("POST", "/gema", json = [1])
cetak(ganti(mentah, "\r", "\\r"))
