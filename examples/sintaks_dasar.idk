# Uji sintaks dasar (smoke test) — merangkum kasus dasar bahasa dalam satu
# berkas deterministik. Menghindari duplikasi dengan contoh lain yang lebih
# spesifik (fibonacci, fungsi, compound_operators, dll.).

cetak("=== variabel & assignment implisit ===")
x = 10
cetak(x)

cetak("=== operator gabungan ===")
x += 5
cetak(x)
x -= 3
cetak(x)
x *= 2
cetak(x)

cetak("=== fungsi & assignment lokal implisit ===")
fungsi kurangi(n) {
    hasil = n - 1
    kembalikan hasil
}
cetak(kurangi(5))

cetak("=== rekursi ===")
fungsi faktorial(n) {
    jika n <= 1 {
        kembalikan 1
    }
    kembalikan n * faktorial(n - 1)
}
cetak(faktorial(5))

cetak("=== fungsi sebagai nilai kelas-satu ===")
m = min
cetak(m(8, 3))
cetak(jenis(m))
a = akar
cetak(a(25))

cetak("=== percabangan ===")
untuk n dalam [0 - 2, 0, 5] {
    jika n > 0 {
        cetak(n, "positif")
    } jika_lain n == 0 {
        cetak(n, "nol")
    } selain {
        cetak(n, "negatif")
    }
}

# Rantai jika_lain berhenti pada cabang PERTAMA yang terpenuhi, walau cabang
# berikutnya juga benar (85 >= 80 dan 85 >= 70 sama-sama benar).
# Issue #63: menumpuk `jika` terpisah bukan padanan elif -- semuanya jalan.
variabel nilai = 85
jika nilai >= 90 {
    cetak("rantai:", "Grade A")
} jika_lain nilai >= 80 {
    cetak("rantai:", "Grade B")
} jika_lain nilai >= 70 {
    cetak("rantai:", "Grade C")
} selain {
    cetak("rantai:", "Grade F")
}

jika nilai >= 90 {
    cetak("terpisah:", "Grade A")
}
jika nilai >= 80 {
    cetak("terpisah:", "Grade B")
}
jika nilai >= 70 {
    cetak("terpisah:", "Grade C")
} selain {
    cetak("terpisah:", "Grade F")
}

cetak("=== perulangan selagi ===")
i = 1
jumlah = 0
selagi i <= 5 {
    jumlah += i
    i += 1
}
cetak("jumlah 1..5:", jumlah)
