# Server uji untuk batas waktu soket.
#
# Sama seperti server_web.idk, tetapi SETIAP soket klien diberi
# soket_batas_waktu(). Klien yang menyambung lalu diam tidak boleh lagi
# membekukan server: galat batas waktu ditangkap, soket ditutup, dan
# permintaan berikutnya tetap dilayani.

impor web

variabel PORT = ke_bulat(ambil_lingkungan("IDK_PORT"))
variabel SISA = ke_bulat(ambil_lingkungan("IDK_SISA"))
variabel BATAS = ke_desimal(ambil_lingkungan("IDK_BATAS"))

variabel app = web.Aplikasi()

app.rute("GET", "/halo", fungsi(req) {
    kembalikan web.teks(200, "halo")
})

# Gelung milik pustaka sekarang yang memasang batas waktu. Nilai BATAS tetap
# dari lingkungan supaya tes bisa menyetelnya pendek. Log dinyalakan: tes
# membuktikan jalur batas waktu dari baris PERINGATAN-nya.
app.jalankan(PORT, BATAS, SISA)
