== muat ==
SANDI_DB "rahasia-sekali" <- lingkungan APP_SANDI_DB
debug benar <- lingkungan APP_DEBUG
host_diizinkan ["a.test", "b.test"] <- lingkungan APP_HOST_DIIZINKAN
mode "dev" <- bawaan
port 9000 <- lingkungan APP_PORT
rasio 0.5 <- bawaan
Konfigurasi({"port": 9000, "mode": "dev", "host_diizinkan": ["a.test", "b.test"], "rasio": 0.5, "debug": benar, "SANDI_DB": "***"})
