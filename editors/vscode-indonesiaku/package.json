{
  "name": "indonesiaku",
  "displayName": "Indonesiaku",
  "description": "Language support for Indonesiaku (.idk): syntax highlighting, LSP diagnostics, completion, hover, go-to-definition, snippets, formatting, and a debugger (indk awakutu).",
  "version": "1.7.0",
  "publisher": "teguh02",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "keywords": [
    "indonesiaku",
    "indk",
    "bahasa indonesia",
    "programming language"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/teguh02/Indonesiaku-Lang.git"
  },
  "main": "./extension.js",
  "files": [
    "extension.js",
    "server.js",
    "debug-adapter.js",
    "awakutu-proses.js",
    "awakutu-sumber.js",
    "language-data.js",
    "language-configuration.json",
    "syntaxes",
    "snippets",
    "fileicons",
    "icon.png",
    "README.md",
    "LICENSE"
  ],
  "activationEvents": [
    "onLanguage:indonesiaku",
    "onDebugResolve:indonesiaku",
    "onDebugDynamicConfigurations:indonesiaku"
  ],
  "contributes": {
    "languages": [
      {
        "id": "indonesiaku",
        "aliases": [
          "Indonesiaku",
          "indk"
        ],
        "extensions": [
          ".idk",
          ".indk"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "indonesiaku",
        "scopeName": "source.indonesiaku",
        "path": "./syntaxes/indonesiaku.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "indonesiaku",
        "path": "./snippets/indonesiaku.code-snippets"
      }
    ],
    "iconThemes": [
      {
        "id": "indonesiaku-icons",
        "label": "Indonesiaku Icons",
        "path": "./fileicons/indonesiaku-icon-theme.json"
      }
    ],
    "commands": [
      { "command": "indonesiaku.jalankan", "title": "Indonesiaku: Jalankan", "icon": "$(play)" },
      { "command": "indonesiaku.periksa", "title": "Indonesiaku: Periksa (Lint)", "icon": "$(search)" },
      { "command": "indonesiaku.rapikan", "title": "Indonesiaku: Rapikan (Format)", "icon": "$(sparkle)" },
      { "command": "indonesiaku.profil", "title": "Indonesiaku: Profil", "icon": "$(graph-line)" },
      { "command": "indonesiaku.awakutu", "title": "Indonesiaku: Debugger (Awakutu)", "icon": "$(debug)" }
    ],
    "breakpoints": [
      { "language": "indonesiaku" }
    ],
    "debuggers": [
      {
        "type": "indonesiaku",
        "label": "Indonesiaku (awakutu)",
        "languages": ["indonesiaku"],
        "program": "./debug-adapter.js",
        "runtime": "node",
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Berkas .idk yang dijalankan di bawah indk awakutu.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Argumen program (global 'argumen').",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Direktori kerja program. Bawaan: folder berkas program.",
                "default": "${fileDirname}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Berhenti di baris pertama program.",
                "default": false
              },
              "jalurIndk": {
                "type": "string",
                "description": "Jalur interpreter indk. Bawaan: setelan indonesiaku.jalurIndk."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "indonesiaku",
            "request": "launch",
            "name": "Debug berkas Indonesiaku",
            "program": "${file}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "Indonesiaku: Debug berkas",
            "description": "Jalankan berkas .idk di bawah debugger awakutu",
            "body": {
              "type": "indonesiaku",
              "request": "launch",
              "name": "Debug berkas Indonesiaku",
              "program": "^\"\\${file}\"",
              "stopOnEntry": false
            }
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "indonesiakuPanel", "title": "Indonesiaku", "icon": "icon.png" }
      ]
    },
    "views": {
      "indonesiakuPanel": [
        { "id": "indonesiaku.aksi", "name": "Perintah" }
      ]
    },
    "menus": {
      "editor/title": [
        { "command": "indonesiaku.jalankan", "when": "resourceLangId == indonesiaku", "group": "navigation" }
      ]
    },
    "configuration": {
      "title": "Indonesiaku",
      "properties": {
        "indonesiaku.jalurIndk": {
          "type": "string",
          "default": "indk",
          "description": "Jalur ke interpreter indk yang dipakai untuk Format Document (indk rapikan), LSP, dan debugger (indk awakutu)."
        }
      }
    }
  },
  "scripts": {
    "test:lsp": "node test-lsp.js",
    "test:format": "node test-format.js",
    "test:dap": "node test-dap.js",
    "test": "node test-lsp.js && node test-format.js && node test-dap.js",
    "package": "npx @vscode/vsce package"
  }
}
