{
  "Cocokkan (pattern matching)": {
    "prefix": "cocokkan",
    "body": [
      "cocokkan ${1:nilai} {",
      "\tkasus ${2:pola} {",
      "\t\t$3",
      "\t}",
      "\tkasus _ {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Pernyataan cocokkan/kasus (pattern matching), kasus _ sebagai bawaan"
  },
  "List comprehension": {
    "prefix": "komprehensi",
    "body": [
      "[${1:ekspresi} untuk ${2:x} dalam ${3:urutan} jika ${4:syarat}]"
    ],
    "description": "List comprehension Indonesiaku"
  },
  "Penugasan berganda": {
    "prefix": "unpack",
    "body": [
      "${1:a}, ${2:b} = ${3:urutan}"
    ],
    "description": "Buka beberapa nilai sekaligus"
  },
  "Fungsi": {
    "prefix": "fungsi",
    "body": [
      "fungsi ${1:nama}(${2:argumen}) {",
      "    ${0}",
      "}"
    ],
    "description": "Buat fungsi Indonesiaku"
  },
  "Jika": {
    "prefix": "jika",
    "body": [
      "jika ${1:kondisi} {",
      "    ${0}",
      "}"
    ],
    "description": "Buat percabangan jika"
  },
  "Jika-lain": {
    "prefix": "jika_lain",
    "body": [
      "jika ${1:kondisi} {",
      "    ${2}",
      "} jika_lain ${3:kondisi_lain} {",
      "    ${0}",
      "} selain {",
      "    ${4}",
      "}"
    ],
    "description": "Buat jika, jika_lain, dan selain"
  },
  "Selagi": {
    "prefix": "selagi",
    "body": [
      "selagi ${1:kondisi} {",
      "    ${0}",
      "}"
    ],
    "description": "Buat perulangan selagi"
  },
  "Untuk dalam": {
    "prefix": "untuk",
    "body": [
      "untuk ${1:item} dalam ${2:daftar} {",
      "    ${0}",
      "}"
    ],
    "description": "Buat perulangan untuk ... dalam"
  },
  "Pola cari": {
    "prefix": "polacari",
    "body": [
      "impor pola",
      "m = pola.cari(\"${1:(\\\\\\\\d+)}\", ${2:teks})",
      "jika m bukan adalah kosong {",
      "    cetak(m.grup(${3:1}))",
      "}"
    ],
    "description": "Cari dengan ekspresi reguler (modul pola)"
  },
  "Pola untuk setiap cocokan": {
    "prefix": "polasemua",
    "body": [
      "impor pola",
      "untuk m dalam pola.iter_cari(\"${1:\\\\\\\\w+}\", ${2:teks}) {",
      "    cetak(m.grup(), m.rentang())",
      "}"
    ],
    "description": "Ulangi setiap cocokan ekspresi reguler"
  },
  "Kelas": {
    "prefix": "kelas",
    "body": [
      "kelas ${1:NamaKelas} {",
      "    init(${2:argumen}) {",
      "        ${0}",
      "    }",
      "}"
    ],
    "description": "Buat kelas dengan konstruktor"
  },
  "Metode ajaib _teks_": {
    "prefix": "_teks_",
    "body": [
      "_teks_() {",
      "    kembalikan ${0:ke_teks(diri.nama)}",
      "}"
    ],
    "description": "Teks objek untuk cetak, ke_teks, dan f-string (K19)"
  },
  "Metode ajaib _sama_": {
    "prefix": "_sama_",
    "body": [
      "_sama_(lain) {",
      "    jika tidak adalah_instansi(lain, ${1:NamaKelas}) {",
      "        kembalikan salah",
      "    }",
      "    kembalikan ${0:diri.nilai == lain.nilai}",
      "}"
    ],
    "description": "Kesetaraan == untuk objek; membuat objek tidak bisa jadi kunci kamus (K19)"
  },
  "Coba kecuali": {
    "prefix": "coba",
    "body": [
      "coba {",
      "    ${1}",
      "} kecuali ${2:galat} {",
      "    ${0}",
      "}"
    ],
    "description": "Buat penanganan kesalahan"
  },
  "Impor pustaka": {
    "prefix": "impor",
    "body": [
      "impor \"pustaka/${1:modul}.idk\"",
      "${0}"
    ],
    "description": "Impor pustaka standar"
  },
  "Cetak": {
    "prefix": "cetak",
    "body": "cetak(${0})",
    "description": "Cetak nilai"
  },
  "Kamus literal": {
    "prefix": "kamus",
    "body": [
      "{\"${1:kunci}\": ${2:nilai}}${0}"
    ],
    "description": "Literal kamus Indonesiaku (kunci harus teks)"
  },
  "Irisan": {
    "prefix": "irisan",
    "body": [
      "${1:daftar}[${2:awal}:${3:akhir}]${0}"
    ],
    "description": "Irisan daftar/teks a[awal:akhir]"
  },
  "Fungsi dengan nilai bawaan": {
    "prefix": "fungsibawaan",
    "body": [
      "fungsi ${1:nama}(${2:wajib}, ${3:opsional}=${4:nilai}) {",
      "\t$0",
      "}"
    ],
    "description": "Fungsi dengan parameter bernilai bawaan (dievaluasi tiap panggilan)"
  },
  "Panggil dengan argumen bernama": {
    "prefix": "panggilbernama",
    "body": [
      "${1:fungsi}(${2:nilai}, ${3:parameter}=${4:nilai})$0"
    ],
    "description": "Panggilan dengan argumen bernama; posisional harus mendahului yang bernama"
  },
  "f-string": {
    "prefix": "fstring",
    "body": [
      "f\"${1:teks} {${2:ekspresi}}\"$0"
    ],
    "description": "Teks dengan ekspresi tersisip"
  },
  "String tiga kutip": {
    "prefix": "tigakutip",
    "body": [
      "\"\"\"${1:baris pertama}",
      "${2:baris kedua}\"\"\"$0"
    ],
    "description": "Teks multi-baris"
  },
  "Fungsi anonim": {
    "prefix": "fungsianonim",
    "body": [
      "fungsi(${1:x}) { kembalikan ${2:x} }$0"
    ],
    "description": "Fungsi tanpa nama sebagai nilai (closure)"
  },
  "Ekspresi kondisional": {
    "prefix": "jikaselain",
    "body": [
      "${1:nilai_benar} jika ${2:kondisi} selain ${3:nilai_salah}$0"
    ],
    "description": "Pilih satu dari dua nilai dalam satu ekspresi"
  },
  "Penegasan (assert)": {
    "prefix": "pastikan",
    "body": [
      "pastikan ${1:kondisi}, \"${2:pesan}\"$0"
    ],
    "description": "Nyatakan kondisi yang harus benar; gagal -> GalatPenegasan"
  },
  "Buka basis data SQLite": {
    "prefix": "dbbuka",
    "body": [
      "variabel ${1:db} = db_buka(\"${2::memory:}\")",
      "$0",
      "db_tutup(${1:db})"
    ],
    "description": "Buka basis data SQLite dan tutup kembali"
  },
  "Kueri SQLite dengan parameter": {
    "prefix": "dbkueri",
    "body": [
      "untuk ${1:baris} dalam db_ambil_semua(${2:db}, \"SELECT ${3:*} FROM ${4:tabel} WHERE ${5:kolom} = ?\", [${6:nilai}]) {",
      "\t$0",
      "}"
    ],
    "description": "Kueri SQLite dengan parameter '?' (jangan merangkai SQL dengan +)"
  },
  "Transaksi SQLite": {
    "prefix": "dbtransaksi",
    "body": [
      "db_mulai(${1:db})",
      "coba {",
      "\t$0",
      "\tdb_komit(${1:db})",
      "} kecuali Galat sebagai e {",
      "\tdb_batal(${1:db})",
      "}"
    ],
    "description": "Transaksi SQLite dengan rollback saat galat"
  },
  "Tupel tanpa kurung": {
    "prefix": "tupel",
    "body": [
      "${1:x} = ${2:1}, ${3:2}"
    ],
    "description": "Tupel tanpa kurung pada sisi kanan penugasan"
  },
  "Kembalikan beberapa nilai": {
    "prefix": "kembalikan2",
    "body": [
      "kembalikan ${1:a}, ${2:b}"
    ],
    "description": "Kembalikan beberapa nilai sebagai tupel"
  },
  "Himpunan beku": {
    "prefix": "himpunanbeku",
    "body": [
      "${1:nama} = himpunan_beku([${2:1, 2}])"
    ],
    "description": "Himpunan yang dapat di-hash (bisa jadi kunci kamus)"
  },
  "Iterator": {
    "prefix": "iter",
    "body": [
      "${1:it} = iter(${2:urutan})",
      "cetak(lanjutkan($1, ${3:\"habis\"}))"
    ],
    "description": "Iterator eksplisit dengan iter() dan lanjutkan()"
  },
  "Impor modul": {
    "prefix": "impor",
    "body": [
      "impor ${1:modul}"
    ],
    "description": "Impor modul sebagai namespace"
  },
  "Impor modul dengan alias": {
    "prefix": "imporsebagai",
    "body": [
      "impor ${1:modul} sebagai ${2:alias}"
    ],
    "description": "Impor modul dengan nama lain"
  },
  "Dari modul impor": {
    "prefix": "dari",
    "body": [
      "dari ${1:modul} impor ${2:nama}"
    ],
    "description": "Impor anggota tertentu dari modul"
  },
  "Jalankan jika utama": {
    "prefix": "utama",
    "body": [
      "jika __nama__ == \"__utama__\" {",
      "\t${1:utama()}",
      "}"
    ],
    "description": "Blok yang hanya jalan saat berkas dijalankan langsung"
  },
  "Metode ajaib _panjang_": {
    "prefix": "_panjang_",
    "body": [
      "_panjang_() {",
      "    kembalikan panjang(${0:diri.isi})",
      "}"
    ],
    "description": "Panjang objek untuk panjang(); juga menentukan kebenarannya (K19)"
  },
  "Metode ajaib _logika_": {
    "prefix": "_logika_",
    "body": [
      "_logika_() {",
      "    kembalikan ${0:panjang(diri.isi) > 0}",
      "}"
    ],
    "description": "Kebenaran objek untuk jika, selagi, tidak, dan/atau (K19)"
  },
  "Metode ajaib _ambil_": {
    "prefix": "_ambil_",
    "body": [
      "_ambil_(kunci) {",
      "    kembalikan ${0:diri.isi[kunci]}",
      "}"
    ],
    "description": "Baca objek[kunci] (K19)"
  },
  "Metode ajaib _atur_": {
    "prefix": "_atur_",
    "body": [
      "_atur_(kunci, nilai) {",
      "    ${0:diri.isi[kunci] = nilai}",
      "}"
    ],
    "description": "Tulis objek[kunci] = nilai (K19)"
  },
  "Metode ajaib _hash_": {
    "prefix": "_hash_",
    "body": [
      "_hash_() {",
      "    kembalikan hash(${0:(diri.x, diri.y)})",
      "}"
    ],
    "description": "Hash objek agar bisa jadi kunci kamus; pasangkan dengan _sama_ (K19)"
  },
  "Metode ajaib _ktambah_": {
    "prefix": "_ktambah_",
    "body": [
      "_ktambah_(lain) {",
      "    kembalikan ${0:${1:NamaKelas}(lain + diri.nilai)}",
      "}"
    ],
    "description": "Cerminan +: dipanggil saat objek ada di kanan, nilai + objek (K19)"
  },
  "Metode ajaib _kkali_": {
    "prefix": "_kkali_",
    "body": [
      "_kkali_(lain) {",
      "    kembalikan ${0:${1:NamaKelas}(lain * diri.nilai)}",
      "}"
    ],
    "description": "Cerminan *: dipanggil saat objek ada di kanan, nilai * objek (K19)"
  },
  "Metode ajaib _iter_": {
    "prefix": "_iter_",
    "body": [
      "_iter_() {",
      "\tkembalikan ${1:diri.isi}",
      "}"
    ],
    "description": "Membuat objek bisa dipakai di 'untuk ... dalam'"
  },
  "Metode ajaib _panggil_": {
    "prefix": "_panggil_",
    "body": [
      "_panggil_(${1:x}) {",
      "\tkembalikan ${2:x}",
      "}"
    ],
    "description": "Membuat objek bisa dipanggil seperti fungsi"
  },
  "Atribut kelas": {
    "prefix": "atribut",
    "body": [
      "${1:NAMA} = ${2:nilai}"
    ],
    "description": "Atribut kelas: nilai bersama semua instance"
  },
  "dengan ... sebagai": {
    "prefix": "dengan",
    "body": [
      "dengan ${1:ekspresi} sebagai ${2:nama} {",
      "\t$0",
      "}"
    ],
    "description": "Manajer konteks: _keluar_() dijamin dipanggil"
  },
  "Metode ajaib _masuk_/_keluar_": {
    "prefix": "_masuk_",
    "body": [
      "_masuk_() {",
      "\tkembalikan diri",
      "}",
      "",
      "_keluar_() {",
      "\t$0",
      "}"
    ],
    "description": "Membuat kelas bisa dipakai di blok 'dengan'"
  },
  "Dekorator": {
    "prefix": "dekorator",
    "body": [
      "fungsi ${1:nama}(f) {",
      "\tfungsi bungkus(${2:x}) {",
      "\t\t$0",
      "\t\tkembalikan f(${2:x})",
      "\t}",
      "\tkembalikan bungkus",
      "}"
    ],
    "description": "Kerangka fungsi dekorator"
  },
  "@properti": {
    "prefix": "properti",
    "body": [
      "@properti",
      "${1:nama}() {",
      "\tkembalikan $0",
      "}"
    ],
    "description": "Metode yang dibaca tanpa tanda kurung"
  },
  "@metode_statis": {
    "prefix": "metode_statis",
    "body": [
      "@metode_statis",
      "${1:nama}() {",
      "\t$0",
      "}"
    ],
    "description": "Metode tanpa penerima"
  },
  "@metode_kelas": {
    "prefix": "metode_kelas",
    "body": [
      "@metode_kelas",
      "${1:nama}() {",
      "\tkembalikan kelas_ini($0)",
      "}"
    ],
    "description": "Metode yang menerima kelasnya sebagai kelas_ini"
  },
  "@abstrak": {
    "prefix": "abstrak",
    "body": [
      "@abstrak",
      "${1:nama}() { }"
    ],
    "description": "Metode yang wajib diisi subkelas"
  },
  "Fungsi beranotasi tipe": {
    "prefix": "fungsitipe",
    "body": [
      "fungsi ${1:nama}(${2:param}: ${3:teks}) -> ${4:teks} {",
      "\t$0",
      "}"
    ],
    "description": "Fungsi dengan anotasi tipe opsional (tidak diperiksa saat runtime)"
  }
}
