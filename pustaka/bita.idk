# pustaka/bita.idk - Data biner (modul `bita`).
# Pemakaian:
#     impor bita
#     dari bita impor ke_bita, ke_teks
#
# Bahasa ini belum punya tipe byte tersendiri, jadi **bita direpresentasikan
# sebagai daftar bulat 0..255**. Encoding UTF-8 dihitung di sini memakai
# ord/chr + bitwise, sehingga aman untuk teks non-ASCII. Saat bahasa punya
# tipe `bita` sendiri, fungsi di modul ini tetap bisa dipertahankan sebagai
# pembungkus.

kelas GalatBita < Galat {
    init(pesan) { diri.pesan = pesan }
}

# _tambah_utf8(kode, hasil) -> tambahkan encoding UTF-8 dari satu code point.
fungsi _tambah_utf8(kode, hasil) {
    jika kode < 128 {
        tambah(hasil, kode)
    } jika_lain kode < 2048 {
        tambah(hasil, 192 + kode // 64)
        tambah(hasil, 128 + kode % 64)
    } jika_lain kode < 65536 {
        tambah(hasil, 224 + kode // 4096)
        tambah(hasil, 128 + (kode // 64) % 64)
        tambah(hasil, 128 + kode % 64)
    } selain {
        tambah(hasil, 240 + kode // 262144)
        tambah(hasil, 128 + (kode // 4096) % 64)
        tambah(hasil, 128 + (kode // 64) % 64)
        tambah(hasil, 128 + kode % 64)
    }
}

# ke_bita(teks) -> daftar byte UTF-8 dari teks.
fungsi ke_bita(teks) {
    variabel hasil = []
    untuk c dalam teks {
        _tambah_utf8(ord(c), hasil)
    }
    kembalikan hasil
}

# ke_teks(bita) -> teks hasil mendekode daftar byte UTF-8.
# GalatBita bila urutannya tidak sah (byte lanjutan menggantung, terpotong).
fungsi ke_teks(data) {
    # Potongan dikumpulkan lalu disatukan sekali dengan teks_gabung:
    # `hasil = hasil + chr(...)` menyalin seluruh string tiap iterasi
    # (teks immutable) -> O(n^2) untuk data yang datang dari soket.
    #
    # Validasi mengikuti RFC 3629, seperti bytes.decode("utf-8") di Python:
    # bita lanjutan harus 0x80..0xBF, bentuk overlong (C0 80 untuk NUL,
    # E0 80 80, ...) ditolak, begitu pula surrogate D800..DFFF dan nilai di
    # atas U+10FFFF. Dulu hanya bita pemimpin yang diperiksa (T-U16).
    variabel potongan = daftar()
    variabel n = panjang(data)
    variabel i = 0
    selagi i < n {
        variabel b = data[i]
        jika b < 128 {
            tambah(potongan, chr(b))
            i = i + 1
            lanjut
        }
        variabel lebar = 0
        variabel nilai = 0
        variabel minimum = 0
        jika b >= 194 dan b < 224 {
            lebar = 2
            nilai = b - 192
            minimum = 128
        } jika_lain b >= 224 dan b < 240 {
            lebar = 3
            nilai = b - 224
            minimum = 2048
        } jika_lain b >= 240 dan b < 245 {
            lebar = 4
            nilai = b - 240
            minimum = 65536
        } jika_lain b >= 128 dan b < 192 {
            naikkan GalatBita("ke_teks: byte 128..191 tanpa pemimpin")
        } selain {
            naikkan GalatBita(format("ke_teks: byte pemimpin tidak sah {}", b))
        }
        jika i + lebar > n {
            naikkan GalatBita("ke_teks: urutan UTF-8 terpotong")
        }
        variabel j = 1
        selagi j < lebar {
            variabel c = data[i + j]
            jika c < 128 atau c >= 192 {
                naikkan GalatBita("ke_teks: byte lanjutan UTF-8 tidak sah")
            }
            nilai = nilai * 64 + (c - 128)
            j = j + 1
        }
        jika nilai < minimum {
            naikkan GalatBita("ke_teks: urutan UTF-8 overlong")
        }
        jika nilai >= 55296 dan nilai < 57344 {
            naikkan GalatBita("ke_teks: surrogate UTF-16 bukan karakter yang sah")
        }
        jika nilai > 1114111 {
            naikkan GalatBita("ke_teks: kode di atas U+10FFFF")
        }
        tambah(potongan, chr(nilai))
        i = i + lebar
    }
    kembalikan teks_gabung(potongan, "")
}

# ke_heksa(bita) -> teks heksa huruf kecil.
fungsi ke_heksa(data) {
    variabel tabel = "0123456789abcdef"
    variabel potongan = daftar()
    untuk b dalam data {
        tambah(potongan, tabel[b // 16])
        tambah(potongan, tabel[b % 16])
    }
    kembalikan teks_gabung(potongan, "")
}

fungsi _nilai_heksa(c) {
    jika c >= "0" dan c <= "9" {
        kembalikan ord(c) - 48
    }
    jika c >= "a" dan c <= "f" {
        kembalikan ord(c) - 87
    }
    naikkan GalatBita("dari_heksa: karakter bukan heksa: " + c)
}

# dari_heksa(teks) -> daftar byte dari teks heksa (panjang harus genap).
fungsi dari_heksa(teks) {
    variabel t = huruf_kecil(teks)
    jika panjang(t) % 2 != 0 {
        naikkan GalatBita("dari_heksa: panjang heksa harus genap")
    }
    variabel hasil = []
    variabel i = 0
    selagi i < panjang(t) {
        tambah(hasil, _nilai_heksa(t[i]) * 16 + _nilai_heksa(t[i + 1]))
        i = i + 2
    }
    kembalikan hasil
}
