# pustaka/web.idk - Modul server HTTP (routing + middleware).
#
# Pemakaian:
#     impor web
#     variabel app = web.Aplikasi()
#     app.rute("GET", "/todos/:id", fungsi(req) { ... })
#     variabel respons = app.tangani(mentah)
#
# app.tangani() bekerja pada TEKS request dan mengembalikan TEKS respons,
# tidak menyentuh soket. Dengan begitu server dapat diuji tanpa jaringan,
# dan gelung soket yang sudah ada tetap dipakai apa adanya.

impor "pustaka/teks.idk"
impor "pustaka/http.idk"
impor "pustaka/json.idk"
impor log

kelas GalatWeb < Galat {}

# _web_nilai_heks(c) -> 0..15, atau -1 bila bukan digit heksadesimal.
fungsi _web_nilai_heks(c) {
    jika c >= "0" dan c <= "9" { kembalikan ord(c) - 48 }
    jika c >= "a" dan c <= "f" { kembalikan ord(c) - 87 }
    jika c >= "A" dan c <= "F" { kembalikan ord(c) - 55 }
    kembalikan 0 - 1
}

# _web_dekode_persen(t) -> teks dengan %XX dan + didekode.
# Urutan % yang tidak sah dibiarkan apa adanya: menolak seluruh permintaan
# karena satu karakter aneh lebih merugikan daripada meneruskannya.
#
# Potongan dikumpulkan ke daftar lalu disatukan sekali dengan teks_gabung,
# BUKAN dengan `hasil = hasil + c`. Teks di sini immutable, jadi menggabung
# per karakter menyalin seluruh string yang sudah terkumpul setiap kali:
# biaya O(n^2). Terukur pada badan urlencoded: 40 KB = 1,6 s, 80 KB = 6,7 s,
# 100 KB = 10,7 s -- empat kali lipat tiap ukuran berlipat dua. Karena gelung
# server melayani satu permintaan pada satu waktu, satu POST 1 MB cukup untuk
# membekukan server berjam-jam. Itu bukan sekadar lambat, itu DoS.
fungsi _web_dekode_persen(t) {
    variabel n = panjang(t)

    # Jalur cepat: tanpa "%" maupun "+" tidak ada yang perlu didekode, dan
    # inilah bentuk badan yang paling umum.
    jika teks_cari(t, "%") == 0 - 1 dan teks_cari(t, "+") == 0 - 1 {
        kembalikan t
    }

    variabel potongan = daftar()
    variabel i = 0
    selagi i < n {
        variabel c = t[i]
        jika c == "+" {
            tambah(potongan, " ")
            i = i + 1
        } jika_lain c == "%" dan i + 2 < n {
            variabel tinggi = _web_nilai_heks(t[i + 1])
            variabel rendah = _web_nilai_heks(t[i + 2])
            jika tinggi == 0 - 1 atau rendah == 0 - 1 {
                tambah(potongan, c)
                i = i + 1
            } selain {
                tambah(potongan, chr(tinggi * 16 + rendah))
                i = i + 3
            }
        } selain {
            tambah(potongan, c)
            i = i + 1
        }
    }
    kembalikan teks_gabung(potongan, "")
}

# _web_urai_query(q) -> kamus. Kunci berulang: yang terakhir menang.
fungsi _web_urai_query(q) {
    variabel hasil = kamus()
    jika q == "" {
        kembalikan hasil
    }
    untuk bagian dalam teks_pisah(q, "&") {
        jika bagian != "" {
            variabel sama = teks_cari(bagian, "=")
            jika sama == 0 - 1 {
                hasil[_web_dekode_persen(bagian)] = ""
            } selain {
                variabel nama = potong(bagian, 0, sama)
                variabel nilai = potong(bagian, sama + 1, panjang(bagian) - sama - 1)
                hasil[_web_dekode_persen(nama)] = _web_dekode_persen(nilai)
            }
        }
    }
    kembalikan hasil
}

# _web_tipe_dasar(ct) -> bagian Content-Type sebelum ';', huruf kecil.
# "application/json; charset=utf-8" -> "application/json"
fungsi _web_tipe_dasar(ct) {
    variabel titik_koma = teks_cari(ct, ";")
    jika titik_koma != 0 - 1 {
        ct = potong(ct, 0, titik_koma)
    }
    kembalikan huruf_kecil(teks_pangkas(ct))
}

# _web_param_tipe(ct, nama) -> nilai parameter Content-Type, "" bila tiada.
# Mengambil boundary dari "multipart/form-data; boundary=----abc".
# Tanda kutip di sekeliling nilai dibuang; RFC 2046 mengizinkan keduanya.
fungsi _web_param_tipe(ct, nama) {
    untuk bagian dalam teks_pisah(ct, ";") {
        variabel b = teks_pangkas(bagian)
        variabel sama = teks_cari(b, "=")
        jika sama != 0 - 1 {
            variabel k = huruf_kecil(teks_pangkas(potong(b, 0, sama)))
            jika k == nama {
                variabel v = teks_pangkas(potong(b, sama + 1, panjang(b) - sama - 1))
                jika panjang(v) >= 2 dan v[0] == "\"" dan v[panjang(v) - 1] == "\"" {
                    v = potong(v, 1, panjang(v) - 2)
                }
                kembalikan v
            }
        }
    }
    kembalikan ""
}

# _web_urai_multipart(badan, boundary) -> [form, berkas].
# Bagian dengan filename= masuk ke berkas, sisanya ke form.
fungsi _web_urai_multipart(badan, boundary) {
    variabel form = kamus()
    variabel berkas = kamus()
    variabel pemisah = "--" + boundary
    untuk bagian dalam teks_pisah(badan, pemisah) {
        # Bagian pertama kosong, bagian terakhir "--\r\n"; keduanya dilewati.
        variabel kosong_batas = teks_pangkas(bagian)
        jika kosong_batas != "" dan kosong_batas != "--" {
            variabel batas = teks_cari(bagian, "\r\n\r\n")
            jika batas != 0 - 1 {
                variabel kepala = potong(bagian, 0, batas)
                variabel isi = potong(bagian, batas + 4, panjang(bagian) - batas - 4)
                # Setiap bagian diakhiri CRLF sebelum pemisah berikutnya.
                jika panjang(isi) >= 2 dan potong(isi, panjang(isi) - 2, 2) == "\r\n" {
                    isi = potong(isi, 0, panjang(isi) - 2)
                }
                variabel nama = ""
                variabel nama_berkas = ""
                untuk baris dalam teks_pisah(kepala, "\r\n") {
                    jika huruf_kecil(potong(teks_pangkas(baris), 0, 19)) == "content-disposition" {
                        nama = _web_param_tipe(baris, "name")
                        nama_berkas = _web_param_tipe(baris, "filename")
                    }
                }
                jika nama != "" {
                    jika nama_berkas == "" {
                        form[nama] = isi
                    } selain {
                        variabel b = kamus()
                        b["nama_berkas"] = nama_berkas
                        b["isi"] = isi
                        berkas[nama] = b
                    }
                }
            }
        }
    }
    kembalikan [form, berkas]
}

# baca_permintaan(klien) -> teks permintaan HTTP UTUH.
#
# soket_baca() mengembalikan apa pun yang sudah tiba (maks ~64KB per
# panggilan), jadi memanggilnya SEKALI memotong badan besar diam-diam.
# Fungsi ini membaca sampai header lengkap, lalu terus membaca sampai
# Content-Length terpenuhi.
#
# maks_badan membatasi badan yang dikumpulkan; "" dikembalikan bila klien
# menutup koneksi sebelum apa pun tiba.

# _web_panjang_bita(t) -> jumlah byte UTF-8 dari teks t.
#
# panjang() menghitung KARAKTER, sedangkan Content-Length menghitung BYTE.
# Untuk badan ber-UTF-8 keduanya berbeda ("☕" = 1 karakter, 3 byte), dan
# gelung yang menunggu `panjang(badan) >= Content-Length` akan menunggu byte
# yang tidak akan pernah datang -- server menggantung selamanya.
fungsi _web_panjang_bita(t) {
    variabel n = 0
    untuk c dalam t {
        variabel k = ord(c)
        jika k < 128 {
            n = n + 1
        } jika_lain k < 2048 {
            n = n + 2
        } jika_lain k < 65536 {
            n = n + 3
        } selain {
            n = n + 4
        }
    }
    kembalikan n
}

fungsi baca_permintaan(klien, maks_badan = 1048576) {
    variabel buf = soket_baca(klien)
    jika buf == "" {
        kembalikan ""
    }
    # Kumpulkan sampai akhir header terlihat.
    variabel batas = teks_cari(buf, "\r\n\r\n")
    selagi batas == 0 - 1 {
        variabel potongan = soket_baca(klien)
        jika potongan == "" {
            kembalikan buf
        }
        buf = buf + potongan
        batas = teks_cari(buf, "\r\n\r\n")
    }

    # Content-Length menentukan sisa yang harus dibaca. Header dicari dalam
    # bentuk huruf kecil karena nama header case-insensitive.
    variabel kepala = huruf_kecil(potong(buf, 0, batas))
    variabel cl = 0 - 1
    untuk baris dalam teks_pisah(kepala, "\r\n") {
        jika potong(baris, 0, 15) == "content-length:" {
            variabel angka = teks_pangkas(potong(baris, 15, panjang(baris) - 15))
            cl = ke_bulat(angka)
        }
    }
    jika cl <= 0 {
        kembalikan buf
    }
    # Tolak lebih awal: jangan kumpulkan badan raksasa hanya untuk menolaknya.
    jika cl > maks_badan {
        kembalikan buf
    }
    # Dibandingkan dalam BYTE. Dihitung inkremental: menghitung ulang seluruh
    # badan tiap putaran membuat unggahan besar jadi O(n^2).
    variabel terkumpul = _web_panjang_bita(potong(buf, batas + 4, panjang(buf) - (batas + 4)))
    selagi terkumpul < cl {
        variabel sisa = soket_baca(klien)
        jika sisa == "" {
            kembalikan buf
        }
        buf = buf + sisa
        terkumpul = terkumpul + _web_panjang_bita(sisa)
    }
    kembalikan buf
}

# _web_segmen(path) -> daftar segmen tanpa yang kosong.
fungsi _web_segmen(path) {
    variabel hasil = []
    untuk s dalam teks_pisah(path, "/") {
        jika s != "" {
            tambah(hasil, s)
        }
    }
    kembalikan hasil
}

# _web_cocok(pola, path) -> kamus params bila cocok, atau kosong.
# Segmen :nama cocok dengan SATU segmen. Jumlah segmen harus sama persis,
# jadi /a/:b tidak cocok dengan /a/b/c.
fungsi _web_cocok(pola, path) {
    variabel p = _web_segmen(pola)
    variabel j = _web_segmen(path)
    jika panjang(p) != panjang(j) {
        kembalikan kosong
    }
    variabel params = kamus()
    variabel i = 0
    selagi i < panjang(p) {
        variabel seg = p[i]
        jika panjang(seg) > 1 dan seg[0] == ":" {
            params[potong(seg, 1, panjang(seg) - 1)] = _web_dekode_persen(j[i])
        } jika_lain seg != j[i] {
            kembalikan kosong
        }
        i = i + 1
    }
    kembalikan params
}

# _web_mime(jalur) -> [tipe_konten, apakah_teks].
# Tak dikenal -> octet-stream, yang aman: peramban mengunduh alih-alih
# menebak dan mengeksekusi.
fungsi _web_mime(jalur) {
    variabel titik = 0 - 1
    variabel i = panjang(jalur) - 1
    selagi i >= 0 {
        jika jalur[i] == "/" {
            hentikan
        }
        jika jalur[i] == "." {
            titik = i
            hentikan
        }
        i = i - 1
    }
    jika titik < 0 {
        kembalikan ["application/octet-stream", salah]
    }
    variabel ext = huruf_kecil(potong(jalur, titik + 1, panjang(jalur) - titik - 1))
    variabel peta = kamus()
    peta["html"] = ["text/html", benar]
    peta["htm"] = ["text/html", benar]
    peta["css"] = ["text/css", benar]
    peta["js"] = ["text/javascript", benar]
    peta["mjs"] = ["text/javascript", benar]
    peta["json"] = ["application/json", benar]
    peta["txt"] = ["text/plain", benar]
    peta["md"] = ["text/markdown", benar]
    peta["csv"] = ["text/csv", benar]
    peta["xml"] = ["application/xml", benar]
    peta["svg"] = ["image/svg+xml", benar]
    peta["png"] = ["image/png", salah]
    peta["jpg"] = ["image/jpeg", salah]
    peta["jpeg"] = ["image/jpeg", salah]
    peta["gif"] = ["image/gif", salah]
    peta["webp"] = ["image/webp", salah]
    peta["ico"] = ["image/x-icon", salah]
    peta["woff"] = ["font/woff", salah]
    peta["woff2"] = ["font/woff2", salah]
    peta["ttf"] = ["font/ttf", salah]
    peta["pdf"] = ["application/pdf", salah]
    peta["zip"] = ["application/zip", salah]
    jika ext dalam peta {
        kembalikan peta[ext]
    }
    kembalikan ["application/octet-stream", salah]
}

# _web_jalur_aman(akar, sisa) -> jalur berkas, atau kosong bila ditolak.
#
# Pemeriksaan dilakukan SETELAH dekode persen, sehingga "%2e%2e%2f" tertutup
# serapat "../". Menolak ".." per segmen (bukan sekadar mencari substring)
# berarti nama berkas sah seperti "catatan..txt" tetap bisa disajikan.
fungsi _web_jalur_aman(akar, sisa) {
    variabel bersih = _web_dekode_persen(sisa)
    # NUL bisa memotong jalur lebih awal di lapisan C di bawah kita.
    untuk c dalam bersih {
        jika ord(c) == 0 {
            kembalikan kosong
        }
    }
    # Backslash diperlakukan sebagai pemisah: di Windows "..\" juga naik level.
    bersih = ganti(bersih, "\\", "/")
    variabel bagian = []
    untuk s dalam teks_pisah(bersih, "/") {
        jika s == "" atau s == "." {
            lanjut
        }
        jika s == ".." {
            # Jangan "naik lalu turun lagi": sekali ada .. , tolak seluruhnya.
            kembalikan kosong
        }
        tambah(bagian, s)
    }
    jika panjang(bagian) == 0 {
        # Direktori akar: tidak ada daftar isi, dan tidak ada berkas.
        kembalikan kosong
    }
    variabel jalur = akar
    jika panjang(jalur) > 0 dan jalur[panjang(jalur) - 1] == "/" {
        jalur = potong(jalur, 0, panjang(jalur) - 1)
    }
    untuk s dalam bagian {
        jalur = jalur + "/" + s
    }
    kembalikan jalur
}

# _web_buang_badan(res) -> respons tanpa badan, header dipertahankan.
#
# Untuk HEAD: RFC 9110 §9.3.2 meminta header yang IDENTIK dengan GET,
# termasuk Content-Length, hanya badannya yang dibuang. Jadi yang dipotong
# tepat setelah "\r\n\r\n" pertama, bukan menghitung ulang apa pun.
fungsi _web_buang_badan(res) {
    variabel i = teks_cari(res, "\r\n\r\n")
    jika i < 0 {
        kembalikan res
    }
    kembalikan potong(res, 0, i + 4)
}

# json(kode, teks_json) -> teks respons HTTP.
fungsi json(kode, badan) {
    kembalikan http_response_json(kode, badan)
}

# teks(kode, isi) -> teks respons HTTP text/plain.
fungsi teks(kode, isi) {
    kembalikan http_response(kode, "text/plain; charset=utf-8", isi)
}

# html(kode, isi) -> teks respons HTTP text/html.
fungsi html(kode, isi) {
    kembalikan http_response(kode, "text/html; charset=utf-8", isi)
}

kelas Aplikasi {
    init(maks_badan = 1048576) {
        diri.rute_daftar = []        # [metode, pola, penangan]
        diri.middleware = []
        diri.penangan_galat = kosong
        diri.statis_daftar = []      # [prefiks, akar]
        # Badan request dibatasi supaya satu klien tidak bisa menghabiskan
        # memori server. 1 MB cukup untuk form dan API; naikkan bila perlu.
        jika ke_bulat(maks_badan) <= 0 {
            naikkan GalatWeb("maks_badan harus bulat positif")
        }
        diri.maks_badan = ke_bulat(maks_badan)
        diri.berjalan = salah
    }

    # statis(prefiks, akar) -> diri. Sajikan berkas di bawah `akar` pada URL
    # yang diawali `prefiks`. Hanya GET dan HEAD; direktori tidak pernah
    # didaftar isinya.
    statis(prefiks, akar) {
        jika jenis(prefiks) != "teks" atau prefiks == "" atau prefiks[0] != "/" {
            naikkan GalatWeb("prefiks statis harus teks yang diawali '/'")
        }
        jika jenis(akar) != "teks" atau akar == "" {
            naikkan GalatWeb("akar statis harus teks yang tidak kosong")
        }
        # Normalkan: simpan tanpa "/" di ujung supaya pencocokan di bawah
        # hanya perlu satu bentuk.
        variabel p = prefiks
        selagi panjang(p) > 1 dan p[panjang(p) - 1] == "/" {
            p = potong(p, 0, panjang(p) - 1)
        }
        tambah(diri.statis_daftar, [p, akar])
        kembalikan diri
    }

    # _statis_tangani(req) -> teks respons, atau kosong bila tidak ada
    # prefiks statis yang cocok (biarkan router biasa yang menjawab).
    _statis_tangani(req) {
        variabel path = req["path"]
        untuk s dalam diri.statis_daftar {
            variabel prefiks = s[0]
            variabel akar = s[1]
            variabel sisa = kosong
            jika path == prefiks {
                sisa = ""
            } jika_lain panjang(path) > panjang(prefiks) {
                jika potong(path, 0, panjang(prefiks)) == prefiks {
                    jika path[panjang(prefiks)] == "/" {
                        sisa = potong(path, panjang(prefiks) + 1,
                                      panjang(path) - panjang(prefiks) - 1)
                    }
                }
            }
            jika sisa adalah kosong {
                lanjut
            }

            variabel metode = req["metode"]
            jika metode != "GET" dan metode != "HEAD" {
                variabel badan405 = "Metode tidak boleh"
                variabel k405 = "HTTP/1.1 405 Method Not Allowed\r\nAllow: GET, HEAD"
                k405 = k405 + "\r\nContent-Type: text/plain; charset=utf-8"
                k405 = k405 + "\r\nContent-Length: " + ke_teks(panjang_byte(badan405))
                k405 = k405 + "\r\nConnection: close\r\n\r\n"
                kembalikan k405 + badan405
            }

            variabel berkas = _web_jalur_aman(akar, sisa)
            jika berkas adalah kosong {
                kembalikan teks(404, "Tidak ditemukan")
            }

            # Satu pesan 404 untuk "tidak ada", "direktori", dan "tak
            # terbaca": membedakannya membocorkan struktur direktori.
            # _info_jalur() mengembalikan kosong (tidak menaikkan galat)
            # bila jalur tidak ada, jadi periksa kosong SEBELUM mengindeks.
            variabel info = kosong
            coba {
                info = _info_jalur(berkas)
            } kecuali e {
                kembalikan teks(404, "Tidak ditemukan")
            }
            jika info adalah kosong {
                kembalikan teks(404, "Tidak ditemukan")
            }
            jika info[0] != "berkas" {
                kembalikan teks(404, "Tidak ditemukan")
            }

            # Symlink: sebuah tautan DI DALAM akar bisa menunjuk ke mana pun
            # di luar, dan pemeriksaan teks jalur di atas tidak melihatnya.
            # Bandingkan jalur nyata (symlink sudah diikuti) berkas dengan
            # jalur nyata akar; berkas di luar akar ditolak seperti 404 biasa.
            variabel akar_nyata = _jalur_nyata(akar)
            variabel berkas_nyata = _jalur_nyata(berkas)
            jika akar_nyata adalah kosong atau berkas_nyata adalah kosong {
                kembalikan teks(404, "Tidak ditemukan")
            }
            variabel batas = akar_nyata
            jika panjang(batas) > 0 dan batas[panjang(batas) - 1] != "/" {
                batas = batas + "/"
            }
            jika panjang(berkas_nyata) <= panjang(batas) {
                kembalikan teks(404, "Tidak ditemukan")
            }
            jika potong(berkas_nyata, 0, panjang(batas)) != batas {
                kembalikan teks(404, "Tidak ditemukan")
            }

            variabel isi = kosong
            coba {
                isi = baca_semua(berkas)
            } kecuali e {
                kembalikan teks(404, "Tidak ditemukan")
            }

            # ETag lemah dari ukuran + waktu ubah. Lemah (W/) karena bukan
            # hash isi: dua tulisan dalam satu detik dengan ukuran sama bisa
            # bertabrakan.
            variabel etag = "W/\"" + ke_teks(ke_bulat(info[1])) + "-"
            etag = etag + ke_teks(ke_bulat(info[2])) + "\""
            jika "if-none-match" dalam req["header"] {
                jika teks_pangkas(req["header"]["if-none-match"]) == etag {
                    variabel k304 = "HTTP/1.1 304 Not Modified\r\nETag: " + etag
                    k304 = k304 + "\r\nConnection: close\r\n\r\n"
                    kembalikan k304
                }
            }

            variabel m = _web_mime(berkas)
            variabel ct = m[0]
            jika m[1] {
                ct = ct + "; charset=utf-8"
            }
            variabel kepala = "HTTP/1.1 200 OK\r\nContent-Type: " + ct
            kepala = kepala + "\r\nContent-Length: " + ke_teks(panjang_byte(isi))
            kepala = kepala + "\r\nETag: " + etag
            kepala = kepala + "\r\nX-Content-Type-Options: nosniff"
            kepala = kepala + "\r\nConnection: close\r\n\r\n"
            # HEAD: header identik dengan GET (termasuk Content-Length),
            # tetapi tanpa badan.
            jika metode == "HEAD" {
                kembalikan kepala
            }
            kembalikan kepala + isi
        }
        kembalikan kosong
    }

    # rute(metode, pola, penangan) -> diri (bisa dirantai).
    # penangan(req) harus mengembalikan teks respons HTTP.
    rute(metode, pola, penangan) {
        jika jenis(pola) != "teks" atau pola == "" atau pola[0] != "/" {
            naikkan GalatWeb("pola rute harus teks yang diawali '/'")
        }
        jika tidak bisa_dipanggil(penangan) {
            naikkan GalatWeb("penangan rute harus bisa dipanggil")
        }
        tambah(diri.rute_daftar, [huruf_besar(metode), pola, penangan])
        kembalikan diri
    }

    # gunakan(mw) -> diri. mw(req, teruskan); panggil teruskan(req) untuk
    # meneruskan, atau kembalikan respons untuk menghentikan rantai.
    gunakan(mw) {
        jika tidak bisa_dipanggil(mw) {
            naikkan GalatWeb("middleware harus bisa dipanggil")
        }
        tambah(diri.middleware, mw)
        kembalikan diri
    }

    # galat(penangan) -> diri. penangan(req, e) menimpa respons 500 bawaan.
    galat(penangan) {
        jika tidak bisa_dipanggil(penangan) {
            naikkan GalatWeb("penangan galat harus bisa dipanggil")
        }
        diri.penangan_galat = penangan
        kembalikan diri
    }

    # _cari(req) -> teks respons.
    _cari(req) {
        variabel metode = req["metode"]
        variabel path = req["path"]
        variabel metode_lain = []
        untuk r dalam diri.rute_daftar {
            variabel params = _web_cocok(r[1], path)
            jika params bukan adalah kosong {
                jika r[0] == metode {
                    req["params"] = params
                    kembalikan r[2](req)
                }
                jika tidak r[0] dalam metode_lain {
                    tambah(metode_lain, r[0])
                }
            }
        }
        # Berkas statis dicoba SETELAH rute eksplisit (rute menang bila ada
        # yang cocok) tetapi SEBELUM 405/404, supaya aset tetap tersaji
        # walau ada pola rute yang kebetulan menutupi prefiksnya.
        variabel res = diri._statis_tangani(req)
        jika res bukan adalah kosong {
            kembalikan res
        }
        # HEAD pada rute yang punya GET: RFC 9110 §9.3.2 mewajibkan server
        # yang mendukung GET juga mendukung HEAD. Jalur berkas statis sudah
        # benar, jalur rute belum -- padahal semua halaman hasil render
        # templat lewat sini, jadi `curl -I`, pemeriksa tautan, dan monitor
        # uptime melihat 405 pada tiap halaman.
        #
        # Penangan GET tetap dijalankan dan badannya dibuang. Tidak hemat,
        # tapi Content-Length WAJIB sama dengan GET dan satu-satunya cara
        # mengetahuinya adalah dengan merender.
        jika metode == "HEAD" {
            untuk r dalam diri.rute_daftar {
                jika r[0] == "GET" {
                    variabel p = _web_cocok(r[1], path)
                    jika p bukan adalah kosong {
                        req["params"] = p
                        kembalikan _web_buang_badan(r[2](req))
                    }
                }
            }
        }
        # Path cocok tapi metode tidak: 405, bukan 404. Membedakan
        # "tidak ada" dari "metode salah" sangat membantu saat debug.
        jika panjang(metode_lain) > 0 {
            # GET menyiratkan HEAD (lihat di atas), jadi Allow harus
            # menyebutnya; menyebut GET saja membuat header ini berbohong.
            # Disisipkan tepat setelah GET, bukan ditempel di akhir: urutan
            # Allow memang bebas, tapi "GET, HEAD, POST" lebih mudah dibaca
            # manusia yang sedang men-debug daripada "GET, POST, HEAD".
            jika "GET" dalam metode_lain {
                jika tidak "HEAD" dalam metode_lain {
                    variabel urut = []
                    untuk mm dalam metode_lain {
                        tambah(urut, mm)
                        jika mm == "GET" {
                            tambah(urut, "HEAD")
                        }
                    }
                    metode_lain = urut
                }
            }
            variabel izin = teks_gabung(metode_lain, ", ")
            variabel badan = "Metode tidak boleh"
            variabel kepala = "HTTP/1.1 405 Method Not Allowed\r\nAllow: " + izin
            kepala = kepala + "\r\nContent-Type: text/plain; charset=utf-8"
            kepala = kepala + "\r\nContent-Length: " + ke_teks(_http_panjang_byte(badan))
            kepala = kepala + "\r\nConnection: close\r\n\r\n"
            kembalikan kepala + badan
        }
        kembalikan teks(404, "Tidak ditemukan")
    }

    # tangani(mentah) -> teks respons HTTP untuk satu request mentah.
    tangani(mentah) {
        variabel req = kosong
        coba {
            req = http_urai_request(mentah)
        } kecuali Galat sebagai e {
            kembalikan teks(400, "Permintaan tidak sah")
        }
        jika req["metode"] == "" {
            kembalikan teks(400, "Permintaan tidak sah")
        }
        # Parser hanya memisah baris pertama per spasi, jadi "bukan http sama
        # sekali" lolos sebagai metode/path/versi. Path HTTP yang sah selalu
        # diawali "/" (bentuk absolut dan CONNECT tidak didukung di sini).
        jika panjang(req["path"]) == 0 atau req["path"][0] != "/" {
            kembalikan teks(400, "Permintaan tidak sah")
        }

        # Pisahkan query dari path.
        variabel path = req["path"]
        variabel tanya = teks_cari(path, "?")
        jika tanya == 0 - 1 {
            req["query"] = kamus()
        } selain {
            req["query"] = _web_urai_query(potong(path, tanya + 1, panjang(path) - tanya - 1))
            req["path"] = potong(path, 0, tanya)
        }
        req["params"] = kamus()

        # Badan: urai sesuai Content-Type. Ketiga kunci SELALU ada supaya
        # penangan tidak perlu memeriksa keberadaan kunci lebih dulu.
        req["form"] = kamus()
        req["berkas"] = kamus()
        req["json"] = kosong

        variabel ct = ""
        jika "content-type" dalam req["header"] {
            ct = req["header"]["content-type"]
        }

        # Transfer-Encoding: chunked tidak didukung. Menolak terang-terangan
        # lebih aman daripada diam-diam memperlakukan ukuran chunk sebagai
        # data badan.
        jika "transfer-encoding" dalam req["header"] {
            jika huruf_kecil(req["header"]["transfer-encoding"]) == "chunked" {
                kembalikan teks(411, "Transfer-Encoding chunked tidak didukung")
            }
        }

        # Batas ukuran diperiksa dari Content-Length, bukan dari badan yang
        # sudah terkumpul: baca_permintaan() sengaja berhenti lebih awal.
        jika "content-length" dalam req["header"] {
            variabel cl = 0 - 1
            coba {
                cl = ke_bulat(teks_pangkas(req["header"]["content-length"]))
            } kecuali e {
                kembalikan teks(400, "Content-Length tidak sah")
            }
            jika cl < 0 {
                kembalikan teks(400, "Content-Length tidak sah")
            }
            jika cl > diri.maks_badan {
                kembalikan teks(413, "Badan permintaan terlalu besar")
            }
        }

        variabel dasar = _web_tipe_dasar(ct)
        jika panjang(req["badan"]) > 0 {
            jika dasar == "application/x-www-form-urlencoded" {
                req["form"] = _web_urai_query(req["badan"])
            } jika_lain dasar == "application/json" {
                coba {
                    req["json"] = json_urai(req["badan"])
                } kecuali e {
                    # JSON rusak adalah kesalahan KLIEN, bukan 500.
                    # Catch-all: json_urai menaikkan TEKS mentah, bukan
                    # instance Galat, jadi "kecuali Galat" tidak menangkapnya.
                    kembalikan teks(400, "JSON tidak sah")
                }
            } jika_lain dasar == "multipart/form-data" {
                variabel boundary = _web_param_tipe(ct, "boundary")
                jika boundary == "" {
                    kembalikan teks(400, "multipart tanpa boundary")
                }
                variabel pasangan = _web_urai_multipart(req["badan"], boundary)
                req["form"] = pasangan[0]
                req["berkas"] = pasangan[1]
            }
        }

        coba {
            kembalikan diri._jalankan(req, 0)
        } kecuali Galat sebagai e {
            jika diri.penangan_galat bukan adalah kosong {
                kembalikan diri.penangan_galat(req, e)
            }
            # Detail galat TIDAK bocor ke klien; operator melihatnya di stderr.
            # tulis_galat() tidak menambah baris baru sendiri, jadi "\n"
            # wajib: tanpa itu pesan ini menempel ke baris log berikutnya.
            tulis_galat("web: galat menangani " + req["metode"] + " "
                        + req["path"] + ": " + ke_teks(e) + "\n")
            kembalikan teks(500, "Galat internal")
        }
    }

    # _jalankan(req, i) -> jalankan middleware ke-i lalu seterusnya.
    _jalankan(req, i) {
        jika i >= panjang(diri.middleware) {
            kembalikan diri._cari(req)
        }
        variabel app = diri
        variabel berikut = i + 1
        kembalikan diri.middleware[i](req, fungsi(r) {
            kembalikan app._jalankan(r, berikut)
        })
    }

    # berhenti() -> diri. Tandai agar gelung jalankan() berhenti SETELAH
    # balasan yang sedang diproses terkirim. Tidak memutus koneksi di tengah
    # jalan; itulah "anggun" yang bisa dijamin di sini.
    berhenti() {
        diri.berjalan = salah
        kembalikan diri
    }

    # _catat(metode, path, status, mulai) -> catat satu permintaan lewat modul
    # `log`, BUKAN cetak() sendiri. Dengan begitu pemakai mendapat ambang,
    # format, dan pengalihan ke berkas yang sudah ada di pustaka itu, dan
    # tidak ada mekanisme log kedua yang harus dirawat terpisah.
    #
    # Badan dan header TIDAK pernah dicatat: badan bisa memuat kata sandi dan
    # header memuat cookie sesi. Hanya metode, path, status, dan durasi.
    _catat(metode, path, status, mulai) {
        variabel ms = bulatkan((jam() - mulai) * 1000, 1)
        variabel pesan = metode + " " + path + " " + ke_teks(status)
        pesan = pesan + " " + ke_teks(ms) + "ms"
        jika status >= 500 {
            diri.pencatat.galat(pesan)
        } jika_lain status >= 400 {
            diri.pencatat.peringatan(pesan)
        } selain {
            diri.pencatat.info(pesan)
        }
    }

    # jalankan(port, ...) -> jumlah koneksi yang dilayani.
    #
    # Gelung server lengkap: batas waktu, galat per koneksi, log, dan
    # penutupan soket. Sebelum ada metode ini setiap pemakai menyalin gelung
    # soketnya sendiri, dan empat dari lima salinan di repo ini lupa memasang
    # batas waktu sehingga bisa dibekukan satu klien yang diam.
    #
    # Parameternya bernama `catat`, BUKAN `log`: parameter bernama `log`
    # membayangi modul `log` yang diimpor di atas, sehingga pemanggilan
    # log.ambil_pencatat() di dalam metode ini gagal dengan "Hanya objek yang
    # memiliki metode".
    #
    # batas_waktu bawaannya 10 detik, BUKAN tanpa batas. Builtin
    # soket_batas_waktu() bawaannya 0 demi kompatibilitas program lama;
    # jalankan() API baru, jadi bawaannya dipilih yang aman. 0 tetap berarti
    # tanpa batas.
    #
    # maks_permintaan = 0 berarti melayani selamanya. Angka positif membuat
    # gelung berhenti setelah sekian koneksi, dipakai tes supaya server
    # berakhir sendiri alih-alih dibunuh.
    #
    # alamat bawaannya "127.0.0.1" dan hanya menerima itu atau "0.0.0.0".
    #
    # ponytail: satu permintaan dilayani pada satu waktu. VM ini satu utas dan
    # belum punya primitif thread, jadi worker/backpressure belum berlaku di
    # sini. Jangan anggap setara server produksi; pakai reverse proxy di depan.
    jalankan(port, batas_waktu = 10, maks_permintaan = 0, catat = benar,
             alamat = "127.0.0.1") {
        jika jenis(port) != "angka" {
            naikkan GalatWeb("port harus angka")
        }
        jika batas_waktu < 0 {
            naikkan GalatWeb("batas_waktu tidak boleh negatif")
        }
        jika maks_permintaan < 0 {
            naikkan GalatWeb("maks_permintaan tidak boleh negatif")
        }

        # Pencatat bernama "web": ambang bawaan pustaka log adalah PERINGATAN,
        # jadi baris INFO per permintaan tidak muncul kecuali ambangnya
        # diturunkan di sini. Pemakai tetap bisa mengubahnya lewat log.atur().
        diri.pencatat = log.ambil_pencatat("web")
        jika catat dan diri.pencatat.ambang adalah kosong {
            diri.pencatat.atur_ambang(log.INFO)
        }

        # Bawaan 127.0.0.1: server tidak otomatis terbuka ke jaringan.
        # Di dalam container WAJIB "0.0.0.0", jika tidak reverse proxy
        # mendapat "Connection refused" padahal server hidup.
        variabel server = soket_dengar(ke_bulat(port), alamat)
        diri.berjalan = benar
        variabel dilayani = 0

        coba {
            selagi diri.berjalan {
                jika maks_permintaan > 0 dan dilayani >= maks_permintaan {
                    hentikan
                }
                variabel klien = soket_terima(server)
                dilayani = dilayani + 1
                variabel mulai = jam()
                coba {
                    soket_batas_waktu(klien, batas_waktu)
                    variabel mentah = baca_permintaan(klien, diri.maks_badan)
                    jika mentah != "" {
                        variabel respons = diri.tangani(mentah)
                        soket_tulis(klien, respons)
                        jika catat {
                            diri._catat(_web_metode_dari(mentah),
                                        _web_path_dari(mentah),
                                        _web_status_dari(respons), mulai)
                        }
                    }
                } kecuali e {
                    # Satu koneksi bermasalah TIDAK boleh mematikan server:
                    # batas waktu, permintaan rusak, atau klien yang pergi di
                    # tengah jalan semuanya berakhir di sini.
                    jika catat {
                        diri.pencatat.peringatan("koneksi dilewati: " + ke_teks(e))
                    }
                } akhirnya {
                    # Di akhirnya supaya soket tidak bocor pada jalur galat
                    # mana pun.
                    soket_tutup(klien)
                }
            }
        } akhirnya {
            soket_tutup(server)
        }
        kembalikan dilayani
    }
}

# _web_metode_dari(mentah) -> metode HTTP, atau "?" bila tak terbaca.
# Untuk log saja, jadi tidak boleh menaikkan galat.
fungsi _web_metode_dari(mentah) {
    variabel sp = teks_cari(mentah, " ")
    jika sp == 0 - 1 {
        kembalikan "?"
    }
    kembalikan potong(mentah, 0, sp)
}

# _web_path_dari(mentah) -> path permintaan, atau "?" bila tak terbaca.
fungsi _web_path_dari(mentah) {
    variabel sp = teks_cari(mentah, " ")
    jika sp == 0 - 1 {
        kembalikan "?"
    }
    variabel sisa = potong(mentah, sp + 1, panjang(mentah) - sp - 1)
    variabel sp2 = teks_cari(sisa, " ")
    jika sp2 == 0 - 1 {
        kembalikan "?"
    }
    kembalikan potong(sisa, 0, sp2)
}

# _web_status_dari(respons) -> kode status dari baris pertama, 0 bila tak
# terbaca. Untuk log saja.
fungsi _web_status_dari(respons) {
    variabel sp = teks_cari(respons, " ")
    jika sp == 0 - 1 {
        kembalikan 0
    }
    variabel sisa = potong(respons, sp + 1, panjang(respons) - sp - 1)
    variabel sp2 = teks_cari(sisa, " ")
    jika sp2 == 0 - 1 {
        kembalikan 0
    }
    coba {
        kembalikan ke_bulat(potong(sisa, 0, sp2))
    } kecuali e {
        kembalikan 0
    }
}


# --- kuki dan sesi (WEB-04) --------------------------------------------------

# _web_heks2(n) -> dua digit heks untuk 0..255.
#
# heksa() bawaan memberi "0xff"/"0x5": ada awalan dan TIDAK ber-padding, jadi
# tidak bisa dipakai menyusun ID dengan panjang tetap.
fungsi _web_heks2(n) {
    variabel digit = "0123456789abcdef"
    variabel hi = n / 16
    variabel lo = n % 16
    kembalikan potong(digit, hi, 1) + potong(digit, lo, 1)
}

# _web_bita_ke_heks(bita) -> teks heks dari daftar bita 0..255.
fungsi _web_bita_ke_heks(bita) {
    variabel bagian = []
    untuk b dalam bita {
        bagian.tambah(_web_heks2(b))
    }
    kembalikan teks_gabung(bagian, "")
}

# _web_kuki_encode(nilai) -> nilai aman untuk Set-Cookie.
#
# RFC 6265 melarang ';' ',' spasi kutip dan backslash di dalam cookie-value.
# Tanpa encoding, nilai yang memuat ';' MENYUNTIKKAN atribut: nilai
# "x; HttpOnly=palsu" akan terbaca peramban sebagai atribut tambahan.
fungsi _web_kuki_encode(nilai) {
    variabel bagian = []
    variabel n = panjang(nilai)
    variabel i = 0
    selagi i < n {
        variabel c = potong(nilai, i, 1)
        variabel k = ord(c)
        jika k < 33 atau k > 126 atau c == ";" atau c == "," atau c == "\"" atau c == "\\" atau c == "%" {
            bagian.tambah("%" + huruf_besar(_web_heks2(k)))
        } selain {
            bagian.tambah(c)
        }
        i = i + 1
    }
    kembalikan teks_gabung(bagian, "")
}

# set_kuki(res, nama, nilai, opsi) -> respons dengan satu baris Set-Cookie.
#
# Respons yang masuk sudah berbentuk teks HTTP lengkap, jadi barisnya
# disisipkan tepat sebelum baris kosong penutup header. Content-Length tidak
# berubah: yang bertambah hanya header.
#
# opsi: kamus berisi path, domain, max-age, httponly, secure, samesite.
fungsi set_kuki(res, nama, nilai, opsi = kosong) {
    variabel o = opsi
    jika o == kosong {
        o = {}
    }
    variabel baris = nama + "=" + _web_kuki_encode(nilai)

    jika "path" dalam o {
        baris = baris + "; Path=" + o["path"]
    } selain {
        baris = baris + "; Path=/"
    }
    jika "domain" dalam o {
        baris = baris + "; Domain=" + o["domain"]
    }
    jika "max-age" dalam o {
        baris = baris + "; Max-Age=" + ke_teks(o["max-age"])
    }
    jika "samesite" dalam o {
        baris = baris + "; SameSite=" + o["samesite"]
    }
    jika "httponly" dalam o {
        jika o["httponly"] {
            baris = baris + "; HttpOnly"
        }
    }
    jika "secure" dalam o {
        jika o["secure"] {
            baris = baris + "; Secure"
        }
    }

    variabel akhir = teks_cari(res, "\r\n\r\n")
    jika akhir < 0 {
        kembalikan res
    }
    variabel kepala = potong(res, 0, akhir)
    variabel ekor = potong(res, akhir, panjang(res) - akhir)
    kembalikan kepala + "\r\nSet-Cookie: " + baris + ekor
}

# baca_kuki(req) -> kamus nama->nilai dari header Cookie.
#
# Nama ganda: yang PERTAMA menang, sama seperti perilaku peramban.
fungsi baca_kuki(req) {
    variabel hasil = {}
    jika "cookie" tidak dalam req["header"] {
        kembalikan hasil
    }
    untuk potongan dalam teks_pisah(req["header"]["cookie"], ";") {
        variabel p = teks_pangkas(potongan)
        variabel sama = teks_cari(p, "=")
        jika sama > 0 {
            variabel nama = teks_pangkas(potong(p, 0, sama))
            variabel nilai = potong(p, sama + 1, panjang(p) - sama - 1)
            jika nama tidak dalam hasil {
                hasil[nama] = _web_dekode_persen(nilai)
            }
        }
    }
    kembalikan hasil
}

# TokoSesi: penyimpanan sesi dalam memori proses.
#
# Cukup untuk server ini yang melayani satu permintaan pada satu waktu.
# Penyimpanan bersama (database/berkas) baru berguna setelah ada pekerja
# paralel, dan itu Fase 20.
kelas TokoSesi {
    init(umur = 3600) {
        diri.data = {}        # sid -> [kedaluwarsa, isi]
        diri.umur = umur
    }

    # ID 32 bita acak dari CSPRNG -> 64 karakter heks.
    # acak()/acak_bulat() TIDAK boleh dipakai di sini: keduanya rand() yang
    # disemai time(), jadi ID sesi dapat ditebak dari header Date.
    _id_baru() {
        kembalikan _web_bita_ke_heks(acak_bita(32))
    }

    buat(isi) {
        variabel sid = diri._id_baru()
        diri.data[sid] = [waktu() + diri.umur, isi]
        kembalikan sid
    }

    ambil(sid) {
        jika sid tidak dalam diri.data {
            kembalikan kosong
        }
        variabel baris = diri.data[sid]
        jika waktu() > baris[0] {
            diri.data.hapus_kunci(sid)
            kembalikan kosong
        }
        kembalikan baris[1]
    }

    hapus(sid) {
        jika sid dalam diri.data {
            diri.data.hapus_kunci(sid)
        }
    }

    # Rotasi ID saat login: ID lama DIHAPUS supaya sesi yang ditanam penyerang
    # sebelum korban masuk tidak ikut hidup (session fixation).
    putar(sid) {
        variabel isi = diri.ambil(sid)
        jika isi == kosong {
            kembalikan kosong
        }
        diri.hapus(sid)
        kembalikan diri.buat(isi)
    }

    bersihkan() {
        variabel sekarang = waktu()
        untuk sid dalam kunci(diri.data) {
            jika sekarang > diri.data[sid][0] {
                diri.data.hapus_kunci(sid)
            }
        }
    }
}

# --- proteksi CSRF (WEB-05) --------------------------------------------------

# _web_banding_tetap(a, b) -> benar bila sama, dengan waktu yang tidak
# bergantung pada isi.
#
# '==' pada teks berhenti di karakter pertama yang berbeda, sehingga LAMA
# perbandingan membocorkan berapa banyak awalan yang sudah benar. Dengan cukup
# percobaan, token dapat ditebak karakter demi karakter. Di sini seluruh
# panjang selalu ditelusuri dan hasilnya diakumulasi.
fungsi _web_banding_tetap(a, b) {
    jika panjang(a) != panjang(b) {
        kembalikan salah
    }
    variabel beda = 0
    variabel i = 0
    selagi i < panjang(a) {
        jika potong(a, i, 1) != potong(b, i, 1) {
            beda = beda + 1
        }
        i = i + 1
    }
    kembalikan beda == 0
}

# token_csrf(toko, sid) -> token milik sesi itu, dibuat sekali lalu disimpan
# DI DALAM data sesi.
#
# Karena ikut tersimpan di sesi: putar() memindahkannya, dan logout
# membatalkannya tanpa kode tambahan.
fungsi token_csrf(toko, sid) {
    variabel isi = toko.ambil(sid)
    jika isi == kosong {
        kembalikan ""
    }
    jika "_csrf" tidak dalam isi {
        isi["_csrf"] = _web_bita_ke_heks(acak_bita(32))
    }
    kembalikan isi["_csrf"]
}

# periksa_csrf(toko, req) -> benar bila permintaan boleh dilanjutkan.
#
# GET/HEAD/OPTIONS lolos tanpa pemeriksaan: menurut definisi metode itu tidak
# mengubah keadaan, dan memaksakan token di sana akan memutus tautan biasa.
fungsi periksa_csrf(toko, req) {
    variabel metode = req["metode"]
    jika metode == "GET" atau metode == "HEAD" atau metode == "OPTIONS" {
        kembalikan benar
    }

    variabel kuki = baca_kuki(req)
    jika "sesi" tidak dalam kuki {
        kembalikan salah
    }
    variabel harap = token_csrf(toko, kuki["sesi"])
    jika harap == "" {
        kembalikan salah
    }

    # Formulir HTML dulu, lalu header untuk jalur AJAX/JSON.
    variabel dapat = ""
    jika "form" dalam req {
        jika "_csrf" dalam req["form"] {
            dapat = req["form"]["_csrf"]
        }
    }
    jika dapat == "" {
        jika "x-csrf-token" dalam req["header"] {
            dapat = teks_pangkas(req["header"]["x-csrf-token"])
        }
    }
    jika dapat == "" {
        kembalikan salah
    }

    kembalikan _web_banding_tetap(harap, dapat)
}

# wajib_csrf(toko) -> penjaga siap pakai, supaya penangan tidak menulis
# cabang 403 yang sama berulang-ulang.
fungsi wajib_csrf(toko) {
    kembalikan fungsi(req) {
        jika periksa_csrf(toko, req) {
            kembalikan kosong
        }
        kembalikan teks(403, "token CSRF tidak sah")
    }
}
