# pustaka/log.idk - Pencatatan (modul `log`), padanan `logging` Python.
# Pemakaian:
#     impor log
#     log.peringatan("disk hampir penuh")   # stderr: PERINGATAN:akar:disk hampir penuh
#     log.atur(ambang = log.INFO, berkas = "aplikasi.log")
#     p = log.ambil_pencatat("db")
#     p.info("tersambung")
#
# Seperti Python: catatan ke stderr secara bawaan, ambang bawaan PERINGATAN
# (debug dan info tidak muncul sampai ambangnya diturunkan), format bawaan
# "{level}:{nama}:{pesan}". Pencatat bernama bertingkat dengan titik:
# "app.db" mewarisi ambang "app" bila ambangnya sendiri belum diatur.
#
# Log terstruktur (Fase 22): log.atur(format = "json") menulis SATU objek JSON
# per baris -- {"waktu", "level", "modul", "pesan", ...data} -- supaya bisa
# diurai Loki/ELK/jq. Setiap metode pencatat menerima `data` (kamus) opsional,
# mis. p.info("tersimpan", {"request_id": req["id"]}). Mode teks mengabaikan
# `data`, jadi format lama tidak berubah sedikit pun.

impor json

DEBUG = 10
INFO = 20
PERINGATAN = 30
GALAT = 40
KRITIS = 50

_NAMA_LEVEL = {10: "DEBUG", 20: "INFO", 30: "PERINGATAN", 40: "GALAT", 50: "KRITIS"}

kelas GalatLog < Galat {
    init(pesan) {
        diri.pesan = pesan
    }
}

# Pengaturan bersama semua pencatat (logging.basicConfig).
_atur = {"format": "{level}:{nama}:{pesan}", "berkas": kosong}

fungsi nama_level(level) {
    jika punya(_NAMA_LEVEL, level) {
        kembalikan _NAMA_LEVEL[level]
    }
    kembalikan f"Level {level}"
}

# Kunci yang selalu ditulis mode JSON; `data` tidak boleh menimpanya, kalau
# tidak satu field kiriman pemanggil bisa memalsukan level atau waktu.
_KUNCI_BAKU = ["waktu", "level", "modul", "pesan"]

# _nilai_json(v) -> teks JSON untuk v, atau teks JSON dari ke_teks(v) bila v
# tidak punya bentuk JSON (objek, nan). Mencatat tidak boleh gagal hanya
# karena satu field-nya tidak bisa diserialkan.
fungsi _nilai_json(v) {
    coba {
        kembalikan json.json_teks(v)
    } kecuali e {
        kembalikan json.json_teks(ke_teks(v))
    }
}

fungsi _baris_json(level, nama, pesan, data) {
    variabel bagian = [
        "\"waktu\":" + json.json_teks(format_tanggal("%Y-%m-%dT%H:%M:%S")),
        "\"level\":" + json.json_teks(nama_level(level)),
        "\"modul\":" + json.json_teks(nama),
        "\"pesan\":" + json.json_teks(ke_teks(pesan))
    ]
    jika data bukan adalah kosong {
        untuk k dalam data {
            jika tidak ke_teks(k) dalam _KUNCI_BAKU {
                tambah(bagian, json.json_teks(ke_teks(k)) + ":" + _nilai_json(data[k]))
            }
        }
    }
    kembalikan "{" + teks_gabung(bagian, ",") + "}"
}

fungsi _periksa_data(data) {
    jika data bukan adalah kosong dan jenis(data) != "kamus" {
        naikkan GalatLog(f"data log harus kamus, bukan {jenis(data)}")
    }
}

fungsi _tulis(level, nama, pesan, data = kosong) {
    variabel baris = kosong
    jika _atur["format"] == "json" {
        baris = _baris_json(level, nama, pesan, data)
    } selain {
        baris = _baris_teks(level, nama, pesan)
    }
    jika _atur["berkas"] adalah kosong {
        tulis_galat(baris + "\n")
    } selain {
        tambah_berkas(_atur["berkas"], baris + "\n")
    }
}

fungsi _baris_teks(level, nama, pesan) {
    variabel baris = _atur["format"]
    baris = ganti(baris, "{level}", nama_level(level))
    baris = ganti(baris, "{nama}", nama)
    baris = ganti(baris, "{waktu}", format_tanggal("%Y-%m-%d %H:%M:%S"))
    # {pesan} terakhir: isi pesan sendiri boleh memuat "{level}" dst.
    baris = ganti(baris, "{pesan}", ke_teks(pesan))
    kembalikan baris
}

kelas Pencatat {
    init(nama) {
        diri.nama = nama
        diri.ambang = kosong     # kosong: ikuti induk
    }

    atur_ambang(level) {
        diri.ambang = level
    }

    # ambang_efektif() -> ambang sendiri, atau induk terdekat ("a.b" -> "a"),
    # atau pencatat akar.
    ambang_efektif() {
        jika diri.ambang bukan adalah kosong {
            kembalikan diri.ambang
        }
        variabel nama = diri.nama
        selagi "." dalam nama {
            variabel i = panjang(nama) - 1
            selagi nama[i] != "." {
                i -= 1
            }
            nama = nama[:i]
            jika punya(_pencatat, nama) dan _pencatat[nama].ambang bukan adalah kosong {
                kembalikan _pencatat[nama].ambang
            }
        }
        kembalikan _akar.ambang
    }

    aktif_untuk(level) {
        kembalikan level >= diri.ambang_efektif()
    }

    # catat(level, pesan, data) -> data (kamus, opsional) hanya tampil di
    # mode JSON. Diperiksa walau levelnya tidak aktif, supaya salah pakai
    # tidak tersembunyi sampai ambang diturunkan di produksi.
    catat(level, pesan, data = kosong) {
        _periksa_data(data)
        jika diri.aktif_untuk(level) {
            _tulis(level, diri.nama, pesan, data)
        }
    }

    debug(pesan, data = kosong) {
        diri.catat(DEBUG, pesan, data)
    }

    info(pesan, data = kosong) {
        diri.catat(INFO, pesan, data)
    }

    peringatan(pesan, data = kosong) {
        diri.catat(PERINGATAN, pesan, data)
    }

    galat(pesan, data = kosong) {
        diri.catat(GALAT, pesan, data)
    }

    kritis(pesan, data = kosong) {
        diri.catat(KRITIS, pesan, data)
    }

    _teks_() {
        kembalikan f"<Pencatat {diri.nama} ({nama_level(diri.ambang_efektif())})>"
    }
}

_akar = Pencatat("akar")
_akar.ambang = PERINGATAN
_pencatat = {"akar": _akar}

# ambil_pencatat(nama = kosong) -> Pencatat bernama; nama yang sama selalu
# memberi objek yang sama. Tanpa nama: pencatat akar.
fungsi ambil_pencatat(nama = kosong) {
    jika nama adalah kosong atau nama == "akar" {
        kembalikan _akar
    }
    jika jenis(nama) != "teks" {
        naikkan GalatLog(f"nama pencatat harus teks, bukan {jenis(nama)}")
    }
    jika tidak punya(_pencatat, nama) {
        _pencatat[nama] = Pencatat(nama)
    }
    kembalikan _pencatat[nama]
}

# atur(ambang=, format=, berkas=) -> logging.basicConfig. Hanya argumen yang
# diberikan yang diubah. `berkas` berupa jalur: catatan DITAMBAHKAN ke
# berkas itu; berkas = "" kembali ke stderr. format = "json" menyalakan log
# terstruktur; teks lain adalah templat {level} {nama} {waktu} {pesan}.
fungsi atur(ambang = kosong, format = kosong, berkas = kosong) {
    jika ambang bukan adalah kosong {
        _akar.ambang = ambang
    }
    jika format bukan adalah kosong {
        jika jenis(format) != "teks" {
            naikkan GalatLog(f"format log harus teks, bukan {jenis(format)}")
        }
        _atur["format"] = format
    }
    jika berkas bukan adalah kosong {
        _atur["berkas"] = kosong jika berkas == "" selain berkas
    }
}

fungsi debug(pesan, data = kosong) {
    _akar.debug(pesan, data)
}

fungsi info(pesan, data = kosong) {
    _akar.info(pesan, data)
}

fungsi peringatan(pesan, data = kosong) {
    _akar.peringatan(pesan, data)
}

fungsi galat(pesan, data = kosong) {
    _akar.galat(pesan, data)
}

fungsi kritis(pesan, data = kosong) {
    _akar.kritis(pesan, data)
}
