# pustaka/json.idk - Serialisasi & parsing JSON (ditulis dalam Indonesiaku).
# Impor: impor "pustaka/json.idk"
# Bergantung pada builtin: jenis, kunci, panjang, karakter/teks[i], potong,
#   ke_teks, ke_angka, ord, chr.
#
# API utama:
#   json_teks(nilai)      -> string JSON (kompak)
#   json_urai(teks)       -> nilai Indonesiaku (kamus/list/angka/string/bool/kosong)

# ---------------------------------------------------------------------------
# SERIALISASI: nilai -> teks JSON
# ---------------------------------------------------------------------------

# Escape sebuah string menjadi literal JSON (termasuk tanda kutip).
#
# Potongan dikumpulkan ke daftar lalu disatukan sekali dengan teks_gabung.
# `hasil = hasil + c` per karakter menyalin seluruh string tiap iterasi (teks
# immutable), jadi biayanya O(n^2) -- dan json_teks() dipakai untuk MENYUSUN
# BALASAN SERVER, sehingga satu respons besar membekukan gelung permintaan.
_JSON_HEKSA = "0123456789abcdef"

# "\u00XX" untuk satu kode di bawah 0x10000.
fungsi _json_u4(kode) {
    kembalikan ("\\u" + _JSON_HEKSA[(kode // 4096) % 16] + _JSON_HEKSA[(kode // 256) % 16] +
        _JSON_HEKSA[(kode // 16) % 16] + _JSON_HEKSA[kode % 16])
}

fungsi json_escape(s) {
    variabel potongan = daftar()
    tambah(potongan, "\"")
    variabel i = 0
    selagi i < panjang(s) {
        variabel c = s[i]
        jika c == "\"" {
            tambah(potongan, "\\\"")
        } jika_lain c == "\\" {
            tambah(potongan, "\\\\")
        } jika_lain c == "\n" {
            tambah(potongan, "\\n")
        } jika_lain c == "\t" {
            tambah(potongan, "\\t")
        } jika_lain c == "\r" {
            tambah(potongan, "\\r")
        } jika_lain ord(c) < 32 {
            # RFC 8259: karakter kontrol wajib di-escape; mentah = JSON tidak sah.
            tambah(potongan, _json_u4(ord(c)))
        } selain {
            tambah(potongan, c)
        }
        i = i + 1
    }
    tambah(potongan, "\"")
    kembalikan teks_gabung(potongan, "")
}

# Kunci objek JSON selalu teks. Seperti json.dumps, kunci angka/logika/kosong
# diubah ke bentuk JSON-nya ({1: "a"} -> {"1":"a"}); tipe lain ditolak.
fungsi _json_kunci(k) {
    variabel t = jenis(k)
    jika t == "teks" {
        kembalikan json_escape(k)
    }
    jika t == "angka" atau t == "logika" atau t == "kosong" {
        kembalikan json_escape(json_teks(k))
    }
    naikkan "json_teks: kunci kamus harus teks, angka, logika, atau kosong, bukan " + t
}

fungsi json_teks(nilai) {
    variabel t = jenis(nilai)
    jika t == "kosong" {
        kembalikan "null"
    }
    jika t == "logika" {
        jika nilai {
            kembalikan "true"
        }
        kembalikan "false"
    }
    jika t == "angka" {
        # nan dan takhingga tidak punya bentuk JSON; "nan"/"takhingga" mentah
        # menghasilkan dokumen yang tidak bisa diurai siapa pun.
        jika nilai - nilai != 0 {
            naikkan "json_teks: " + ke_teks(nilai) + " bukan angka JSON yang sah"
        }
        kembalikan ke_teks(nilai)
    }
    jika t == "teks" {
        kembalikan json_escape(nilai)
    }
    jika t == "daftar" {
        variabel potongan = daftar()
        variabel i = 0
        selagi i < panjang(nilai) {
            tambah(potongan, json_teks(nilai[i]))
            i = i + 1
        }
        kembalikan "[" + teks_gabung(potongan, ",") + "]"
    }
    jika t == "kamus" {
        variabel potongan = daftar()
        variabel daftar_kunci = kunci(nilai)
        variabel i = 0
        selagi i < panjang(daftar_kunci) {
            variabel k = daftar_kunci[i]
            tambah(potongan, _json_kunci(k) + ":" + json_teks(nilai[k]))
            i = i + 1
        }
        kembalikan "{" + teks_gabung(potongan, ",") + "}"
    }
    # tipe lain (objek/kelas/berkas) tidak didukung
    naikkan "json_teks: tipe tidak didukung: " + t
}

# ---------------------------------------------------------------------------
# PARSING: teks JSON -> nilai
# Memakai kursor global _json_pos di atas string global _json_src.
# ---------------------------------------------------------------------------

_json_src = ""
_json_pos = 0

fungsi _json_di_akhir() {
    kembalikan _json_pos >= panjang(_json_src)
}

fungsi _json_intip() {
    jika _json_di_akhir() {
        kembalikan ""
    }
    kembalikan _json_src[_json_pos]
}

fungsi _json_maju() {
    global _json_pos
    variabel c = _json_intip()
    _json_pos = _json_pos + 1
    kembalikan c
}

fungsi _json_lewati_spasi() {
    global _json_pos
    selagi tidak _json_di_akhir() {
        variabel c = _json_intip()
        jika c == " " atau c == "\t" atau c == "\n" atau c == "\r" {
            _json_pos = _json_pos + 1
        } selain {
            hentikan
        }
    }
}

fungsi _json_adalah_digit(c) {
    jika c == "" {
        kembalikan salah
    }
    variabel k = ord(c)
    kembalikan k >= 48 dan k <= 57
}

# Digit heksa -> nilainya, huruf kecil dan besar. Dibangun di dalam fungsi
# supaya variabel gelungnya tidak bocor ke namespace pengimpor.
fungsi _json_tabel_heksa() {
    variabel tabel = {}
    untuk i dalam rentang(16) {
        tabel[_JSON_HEKSA[i]] = i
        tabel[huruf_besar(_JSON_HEKSA[i])] = i
    }
    kembalikan tabel
}
_JSON_NILAI_HEKSA = _json_tabel_heksa()

# Empat digit heksa setelah "\u" -> kodenya.
fungsi _json_baca_u4() {
    variabel kode = 0
    variabel j = 0
    selagi j < 4 {
        variabel c = _json_maju()
        variabel d = -1
        jika c != "" dan c dalam _JSON_NILAI_HEKSA {
            d = _JSON_NILAI_HEKSA[c]
        }
        jika d < 0 {
            naikkan "json_urai: \\u harus diikuti empat digit heksa pada posisi " + ke_teks(_json_pos)
        }
        kode = kode * 16 + d
        j = j + 1
    }
    kembalikan kode
}

# Satu escape "\u....", termasuk pasangan surrogate UTF-16 untuk karakter di
# atas U+FFFF ("😀" -> 😀). Surrogate tunggal tidak punya bentuk
# UTF-8, jadi ditolak.
fungsi _json_urai_u() {
    global _json_pos
    variabel kode = _json_baca_u4()
    jika kode >= 56320 dan kode < 57344 {
        naikkan "json_urai: surrogate rendah \\u tanpa pasangan"
    }
    jika kode >= 55296 dan kode < 56320 {
        jika potong(_json_src, _json_pos, 2) != "\\u" {
            naikkan "json_urai: surrogate tinggi \\u tanpa pasangan"
        }
        _json_pos = _json_pos + 2
        variabel rendah = _json_baca_u4()
        jika rendah < 56320 atau rendah >= 57344 {
            naikkan "json_urai: surrogate tinggi \\u tanpa pasangan"
        }
        kode = 65536 + (kode - 55296) * 1024 + (rendah - 56320)
    }
    kembalikan chr(kode)
}

# Literal teks bahasa ini tidak mengenal \b dan \f, jadi pakai chr().
_JSON_ESCAPE = {"\"": "\"", "\\": "\\", "/": "/", "b": chr(8), "f": chr(12),
                "n": "\n", "r": "\r", "t": "\t"}

fungsi _json_urai_string() {
    jika _json_intip() != "\"" {
        naikkan "json_urai: harapkan string pada posisi " + ke_teks(_json_pos)
    }
    _json_maju()
    # Potongan disatukan sekali: `hasil = hasil + c` per karakter kuadratik.
    variabel potongan = daftar()
    selagi tidak _json_di_akhir() {
        variabel c = _json_maju()
        jika c == "\"" {
            kembalikan teks_gabung(potongan, "")
        }
        jika c == "\\" {
            variabel e = _json_maju()
            jika e == "u" {
                tambah(potongan, _json_urai_u())
            } jika_lain e != "" dan e dalam _JSON_ESCAPE {
                tambah(potongan, _JSON_ESCAPE[e])
            } selain {
                naikkan "json_urai: escape tidak sah '\\" + e + "' pada posisi " + ke_teks(_json_pos - 1)
            }
        } jika_lain ord(c) < 32 {
            naikkan "json_urai: karakter kontrol mentah di dalam string pada posisi " + ke_teks(_json_pos - 1)
        } selain {
            tambah(potongan, c)
        }
    }
    naikkan "json_urai: string tidak ditutup"
}

# Satu digit atau lebih; galat bila tidak ada satu pun.
fungsi _json_digit_wajib() {
    global _json_pos
    jika tidak _json_adalah_digit(_json_intip()) {
        naikkan "json_urai: angka tidak sah pada posisi " + ke_teks(_json_pos)
    }
    selagi _json_adalah_digit(_json_intip()) {
        _json_pos = _json_pos + 1
    }
}

fungsi _json_urai_angka() {
    global _json_pos
    variabel mulai = _json_pos
    # Tata bahasa RFC 8259: -?(0|[1-9][0-9]*)(.[0-9]+)?([eE][+-]?[0-9]+)?
    # "01", "1.", "-" dan "1e" dulu diterima diam-diam.
    jika _json_intip() == "-" {
        _json_pos = _json_pos + 1
    }
    jika _json_intip() == "0" {
        _json_pos = _json_pos + 1
    } selain {
        _json_digit_wajib()
    }
    jika _json_intip() == "." {
        _json_pos = _json_pos + 1
        _json_digit_wajib()
    }
    # notasi eksponen (e/E)
    variabel ce = _json_intip()
    jika ce == "e" atau ce == "E" {
        _json_pos = _json_pos + 1
        variabel cs = _json_intip()
        jika cs == "+" atau cs == "-" {
            _json_pos = _json_pos + 1
        }
        _json_digit_wajib()
    }
    kembalikan ke_angka(potong(_json_src, mulai, _json_pos - mulai))
}

fungsi _json_cocok_literal(kata) {
    global _json_pos
    variabel n = panjang(kata)
    jika potong(_json_src, _json_pos, n) == kata {
        _json_pos = _json_pos + n
        kembalikan benar
    }
    kembalikan salah
}

fungsi _json_urai_nilai() {
    _json_lewati_spasi()
    variabel c = _json_intip()
    jika c == "\"" {
        kembalikan _json_urai_string()
    }
    jika c == "{" {
        kembalikan _json_urai_objek()
    }
    jika c == "[" {
        kembalikan _json_urai_larik()
    }
    jika c == "-" atau _json_adalah_digit(c) {
        kembalikan _json_urai_angka()
    }
    jika _json_cocok_literal("true") {
        kembalikan benar
    }
    jika _json_cocok_literal("false") {
        kembalikan salah
    }
    jika _json_cocok_literal("null") {
        kembalikan kosong
    }
    naikkan "json_urai: karakter tak terduga pada posisi " + ke_teks(_json_pos)
}

fungsi _json_urai_objek() {
    _json_maju()   # konsumsi '{'
    variabel hasil = kamus()
    _json_lewati_spasi()
    jika _json_intip() == "}" {
        _json_maju()
        kembalikan hasil
    }
    selagi benar {
        _json_lewati_spasi()
        variabel k = _json_urai_string()
        _json_lewati_spasi()
        jika _json_maju() != ":" {
            naikkan "json_urai: harapkan ':' dalam objek"
        }
        hasil[k] = _json_urai_nilai()
        _json_lewati_spasi()
        variabel c = _json_maju()
        jika c == "}" {
            kembalikan hasil
        }
        jika c != "," {
            naikkan "json_urai: harapkan ',' atau '}' dalam objek"
        }
    }
}

fungsi _json_urai_larik() {
    _json_maju()   # konsumsi '['
    variabel hasil = []
    _json_lewati_spasi()
    jika _json_intip() == "]" {
        _json_maju()
        kembalikan hasil
    }
    selagi benar {
        tambah(hasil, _json_urai_nilai())
        _json_lewati_spasi()
        variabel c = _json_maju()
        jika c == "]" {
            kembalikan hasil
        }
        jika c != "," {
            naikkan "json_urai: harapkan ',' atau ']' dalam larik"
        }
    }
}

fungsi json_urai(teks) {
    global _json_pos, _json_src
    _json_src = teks
    _json_pos = 0
    variabel hasil = _json_urai_nilai()
    _json_lewati_spasi()
    # "1 2", "[1]x" dan "truex" dulu dikembalikan sebagian tanpa galat.
    jika tidak _json_di_akhir() {
        naikkan "json_urai: data tambahan setelah nilai pada posisi " + ke_teks(_json_pos)
    }
    kembalikan hasil
}
